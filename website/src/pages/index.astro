---
import Logo from "../components/Logo.astro";
import {
  description,
  site,
  socialDescription,
  socialImageAlt,
  socialImageHeight,
  socialImagePath,
  socialImageType,
  socialImageWidth,
  title,
} from "../social.mjs";
import "../styles/site.css";

const base = `${import.meta.env.BASE_URL.replace(/[/]$/, "")}/`;
const path = (value: string) => `${base}${value.replace(/^[/]/, "")}`;
const socialImage = `${site}${socialImagePath}`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content={description}
    />
    <meta name="theme-color" content="#f3eddf" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${site}/`} />
    <meta property="og:site_name" content="Ink" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content={socialImageType} />
    <meta property="og:image:width" content={socialImageWidth} />
    <meta property="og:image:height" content={socialImageHeight} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="canonical" href={`${site}/`} />
    <link rel="icon" href={path("/favicon.svg")} />
    <title>{title}</title>
  </head>
  <body>
    <div class="paper-grain" aria-hidden="true"></div>
    <header class="nav shell">
      <a class="brand" href={path("/")} aria-label="Ink home"><Logo
          size={36}
        /><strong>ink</strong></a>
      <nav aria-label="Main navigation">
        <a href={path("/docs/")}>Field notes</a>
        <a href="https://github.com/dkarter/ink">GitHub</a>
      </nav>
    </header>

    <main>
      <section class="status-band" aria-label="Product summary">
        <div class="shell">
          <strong>Small by design</strong><span>Vim muscle memory for the
            moments your scripts ask for input.</span>
        </div>
      </section>

      <section class="hero shell">
        <div class="hero-copy">
          <p class="eyebrow">A fast Vim interface for script input</p>
          <h1>Stay in<br /><em>Vim.</em></h1>
          <p class="lede">
            Ink gives scripts a fast, focused input and textarea with the Vim
            motions you already know. Edit, select, undo, redo, and submit
            without opening a full editor.
          </p>
          <div class="actions">
            <a class="primary" href={path("/docs/")}>Read the docs <span
                aria-hidden="true"
              >→</span></a>
            <a href="https://github.com/dkarter/ink">View source</a>
          </div>
        </div>

        <div
          class="prompt-sheet"
          aria-label="Ink textarea interface illustration"
        >
          <div class="sheet-meta">
            <span>TEXTAREA · VISUAL MODE</span><span>ink textarea</span>
          </div>
          <div class="editor-lines" aria-hidden="true">
            <span class="number">1</span><span>Write release notes for the next
              build.</span>
            <span class="number">2</span><span>Keep them concise, specific, and
              useful.</span>
            <span class="number">3</span><span class="selection"
            >Mention the new terminal editor.</span>
            <span class="number">4</span><span class="cursor-line">▌</span>
          </div>
          <div class="mode-line">
            <b>VISUAL LINE</b><span>3:1</span><span>esc normal · ctrl-d
              accept</span>
          </div>
        </div>
      </section>

      <section class="manifesto shell">
        <p class="section-mark">01 / CONTRACT</p>
        <h2>
          Don’t leave your <i>muscle memory</i> behind for a prompt.
        </h2>
        <p>
          Ink puts familiar Vim editing where scripts ask for input. It starts
          quickly, handles the text, and gets out of the way.
        </p>
      </section>

      <section class="capabilities shell" aria-label="Capabilities">
        <article>
          <span>01</span><h3>One line or many</h3>
          <p>
            <code>ink input</code> targets compact values. <code>ink
              textarea</code> targets prose and structured multiline text.
          </p>
        </article>
        <article>
          <span>02</span><h3>Familiar by design</h3>
          <p>
            Normal, Insert, and Visual modes work in both prompts, with Visual
            Line and Visual Block selection in textarea.
          </p>
        </article>
        <article>
          <span>03</span><h3>Room to rethink</h3>
          <p>
            Undo and redo let you experiment freely, backed by a useful surface
            of the editing commands your hands expect.
          </p>
        </article>
        <article>
          <span>04</span><h3>Built for scripts</h3>
          <p>
            Seed from a flag or pipe, edit interactively, then pass the accepted
            value to the next command.
          </p>
        </article>
      </section>

      <section class="notation shell">
        <div>
          <p class="section-mark">02 / FLOW</p>
          <h2>Script input.<br />Vim instincts.<br />Clean output.</h2>
          <p>
            The shell stays in charge. Ink adds a brief, comfortable editing
            layer, then sends the accepted value on its way.
          </p>
          <a href={path("/docs/cli/")}>Explore the CLI →</a>
        </div>
        <ol>
          <li><span>IN</span><code>git diff --stat | ink textarea</code></li>
          <li><span>EDIT</span><code>NORMAL → INSERT → NORMAL</code></li>
          <li><span>OUT</span><code>accepted text on stdout</code></li>
        </ol>
      </section>

      <section class="themes shell">
        <div class="theme-copy">
          <p class="section-mark">03 / COLOR STUDIES</p>
          <h2>Looks like it belongs.</h2>
          <p>
            Choose from bundled palettes or tune semantic colors so Ink feels
            native to your terminal, not bolted onto it.
          </p><a href={path("/docs/themes/")}>Explore themes →</a>
        </div>
        <div class="swatches" aria-label="Preview of theme palettes">
          <div class="swatch tokyo">
            <b>Tokyo
              Night</b><span></span><span></span><span></span><span></span>
          </div>
          <div class="swatch latte">
            <b>Catppuccin
              Latte</b><span></span><span></span><span></span><span></span>
          </div>
          <div class="swatch nord">
            <b>Nord</b><span></span><span></span><span></span><span></span>
          </div>
        </div>
      </section>

      <section class="closing shell">
        <Logo size={64} />
        <p class="section-mark">READY WHEN YOU ARE</p>
        <h2>Keep your hands<br />in Vim.</h2>
        <p>
          Give your scripts better input without bringing along a full editor.
        </p>
        <div class="actions">
          <a class="primary" href={path("/docs/")}>Open the docs <span
              aria-hidden="true"
            >→</span></a><a href="https://github.com/dkarter/ink"
          >View source</a>
        </div>
      </section>
    </main>

    <footer class="shell">
      <a class="brand" href={path("/")}><Logo size={28} /><strong
        >ink</strong></a><span>Vim muscle memory for script input.</span><a
        href="https://github.com/dkarter/ink"
      >GitHub</a>
    </footer>
  </body>
</html>
