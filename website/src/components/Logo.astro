---
interface Props {
  size?: number;
  label?: string;
}

const { size = 36, label } = Astro.props;
---

<svg
  class="ink-logo"
  width={size}
  height={size}
  viewBox="0 0 64 64"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  <rect class="logo-frame" x="4" y="15" width="56" height="34" rx="6" />
  <path class="logo-text" d="M14 27h13M14 37h20" />
  <path class="logo-cursor" d="M44 24v16" />
</svg>

<style>
.ink-logo {
  display: block;
  overflow: visible;
}
.logo-frame {
  fill: var(--logo-paper, #fffaf0);
  stroke: var(--logo-ink, #17232f);
  stroke-width: 3;
}
.logo-text, .logo-cursor {
  fill: none;
  stroke-width: 3;
  stroke-linecap: square;
}
.logo-text {
  stroke: var(--logo-accent, #315c9b);
}
.logo-cursor {
  stroke: var(--logo-cursor, #c34d3f);
  stroke-width: 4;
}
</style>
