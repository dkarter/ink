---
interface Props {
  size?: number;
  label?: string;
}

const { size = 36, label } = Astro.props;
---

<svg
  class="ink-logo"
  width={size}
  height={size}
  viewBox="0 0 64 64"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  <rect class="logo-frame" x="8" y="8" width="48" height="48" rx="15" />
  <path class="logo-cursor" d="M22 20v24" />
</svg>

<style>
.ink-logo {
  display: block;
  overflow: visible;
}
.logo-frame {
  fill: var(--logo-paper, #fffaf0);
  stroke: var(--logo-ink, #17232f);
  stroke-width: 3;
}
.logo-cursor {
  fill: none;
  stroke: var(--logo-accent, #315c9b);
  stroke-width: 6;
  stroke-linecap: round;
}
</style>
